@startuml casos-de-uso
' StormCIP · Diagrama de casos de uso · versión 2 (23-11-2026)
' Fuente: historias de usuario (Plan del proyecto), firestore.rules, functions/src y web/src de main (commit 22125d2).
' Para verlo: https://www.plantuml.com/plantuml o la extensión PlantUML de VS Code.

left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome

actor "Visor\n(jefe de producción / cliente)" as Visor
actor "Operador" as Operador
actor "Administrador" as Admin
actor "Sensor WQS-LB\nvía The Things Stack" as Sensor <<sistema externo>>
actor "Tiempo\n(cada 60 min)" as Tiempo <<temporizador>>

Operador -|> Visor
Admin -|> Operador

rectangle "StormCIP" {
  usecase "Iniciar sesión" as UC01
  usecase "Ver Central CIP\n(circuitos y limpiezas del día)" as UC02
  usecase "Ver ciclo en vivo\n(variables y etapa)" as UC03
  usecase "Ver gráfico por\nvariables y periodo" as UC04
  usecase "Ver proyección y\navisos de tendencia" as UC05
  usecase "Ver alertas e historial de alertas" as UC06
  usecase "Ver registros de ciclo\ne indicadores" as UC07
  usecase "Ver consumos de agua y químico" as UC08
  usecase "Ver reporte para gerencia" as UC09
  usecase "Ver predicción y ahorro" as UC12

  usecase "Reconocer alerta" as UC10
  usecase "Iniciar o detener\nciclo de demostración" as UC11
  usecase "Calcular indicadores\nal cerrar el ciclo" as UC35
  usecase "Recalcular recomendaciones" as UC36

  usecase "Gestionar usuarios y roles\n(crear, cambiar rol,\nactivar o desactivar, restablecer)" as UC20
  usecase "Gestionar planes de\nlimpieza y límites" as UC22
  usecase "Decidir recomendaciones\n(aprobar, asignar a mantención,\ndescartar)" as UC25
  usecase "Ver estado de los equipos\n<<sin pantalla>>" as UC21
  usecase "Recalcular indicadores" as UC23
  usecase "Controlar simulación\nde la línea piloto" as UC24

  usecase "Enviar lectura" as UC30
  usecase "Enviar estado del equipo\n(FPort 5)" as UC31
  usecase "Decodificar payload" as UC32
  usecase "Validar rango físico" as UC33
  usecase "Generar alerta por umbral" as UC34
  usecase "Proyectar fin del enjuague" as UC37

  usecase "Generar ciclos programados\nde la planta de demostración" as UC40
}

Visor --> UC01
Visor --> UC02
Visor --> UC03
Visor --> UC04
Visor --> UC05
Visor --> UC06
Visor --> UC07
Visor --> UC08
Visor --> UC09
Visor --> UC12

Operador --> UC10
Operador --> UC11

Admin --> UC20
Admin --> UC22
Admin --> UC25
Admin --> UC21
Admin --> UC23
Admin --> UC24

Sensor --> UC30
Sensor --> UC31

Tiempo --> UC40

UC30 ..> UC32 : <<include>>
UC30 ..> UC33 : <<include>>
UC31 ..> UC32 : <<include>>
UC34 ..> UC30 : <<extend>>\n(valor fuera de umbral)
UC37 ..> UC30 : <<extend>>\n(etapa de enjuague)
UC35 ..> UC11 : <<extend>>\n(al cerrar)
UC36 ..> UC11 : <<extend>>\n(al cerrar)
@enduml
