rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Rol viene de custom claims (lo asigna la Function setUserRole)
    function signedIn()  { return request.auth != null; }
    function rol()       { return request.auth.token.rol; }
    function isAdmin()   { return signedIn() && rol() == 'admin'; }
    function isOper()    { return signedIn() && rol() in ['admin', 'operador']; }
    function canRead()   { return signedIn() && rol() in ['admin', 'operador', 'visor']; }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }
    match /plantas/{plantaId} {
      allow read: if canRead();
      allow write: if isAdmin();
      match /lineas/{lineaId} {
        allow read: if canRead();
        allow write: if isAdmin();
      }
    }
    match /ciclos/{cicloId} {
      allow read: if canRead();
      allow create, update: if isOper();
      // Sin delete: un ciclo cerrado o cancelado queda como 'finalizado' o 'abortado'.
      // Borrar el documento dejaría huérfanas sus lecturas (Firestore no borra en cascada).
      // Lecturas solo las escribe el backend (ingestLectura)
      match /lecturas/{lecturaId} {
        allow read: if canRead();
        allow write: if false;
      }
    }
    // Consulta de GRUPO de colección: el histórico entre ciclos del dashboard
    // (collectionGroup('lecturas')) NO se evalúa con la regla anidada de arriba,
    // necesita esta regla propia. Sin ella la query falla con permission-denied
    // aunque el usuario pueda leer cada ciclo por separado.
    match /{path=**}/lecturas/{lecturaId} {
      allow read: if canRead();
      allow write: if false;
    }
    match /alertas/{alertaId} {
      allow read: if canRead();
      // Operador solo puede "reconocer" la alerta
      allow update: if isOper() && request.resource.data.diff(resource.data)
        .affectedKeys().hasOnly(['reconocida', 'reconocidaPor', 'reconocidaEn']);
      allow create, delete: if false;
    }
    match /dispositivos/{deviceId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    // Estado de planta en vivo (PLC / simulador-cip): solo lo escribe el backend
    match /estadoProceso/{lineaId} {
      allow read: if canRead();
      allow write: if false;
    }
    // Control de la demo (botón "Iniciar simulación" del dashboard). Solo un admin
    // escribe una orden: iniciar con un escenario, o detener. El simulador (Admin SDK)
    // la lee, valida y la ejecuta; las reglas solo fijan la forma de la orden.
    match /simulacionControl/{lineaId} {
      allow read: if canRead();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['comando', 'escenario', 'solicitudId', 'solicitadoPor', 'solicitadoEn'])
        && request.resource.data.keys().hasAll(['comando', 'solicitudId', 'solicitadoPor', 'solicitadoEn'])
        && request.resource.data.comando in ['iniciar', 'detener']
        && (request.resource.data.comando == 'detener' || request.resource.data.escenario in ['normal', 'falla'])
        && request.resource.data.solicitudId is string
        && request.resource.data.solicitudId.size() >= 8 && request.resource.data.solicitudId.size() <= 64
        && request.resource.data.solicitadoPor == request.auth.uid
        && request.resource.data.solicitadoEn == request.time;
      allow delete: if false;
    }
    // Latido y estado del simulador: solo lo escribe el simulador (Admin SDK)
    match /simulacionEstado/{lineaId} {
      allow read: if canRead();
      allow write: if false;
    }
    match /configuracion/{docId} {
      allow read: if canRead();
      allow write: if isAdmin();
    }
  }
}